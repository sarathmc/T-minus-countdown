PORT=3000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql://postgres:password@localhost:5432/tminus?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
API_URL=https://your-domain.example
JSON_BODY_LIMIT=256kb
VAPID_SUBJECT=mailto:notifications@example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WORKER_PORT=3001
PUSH_WORKER_INTERVAL_MS=30000
# Comma-separated owned user UUIDs for the separately deployed worker.
PUSH_WORKER_USER_IDS=
# Use a Supabase project whose access tokens are signed with asymmetric ES256/RS256 keys.
# VAPID_PRIVATE_KEY is server-only and must never be placed in Angular configuration.
# No service-role key is needed by this API.