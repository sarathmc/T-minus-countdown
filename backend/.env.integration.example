# Dedicated non-production Supabase project only.
# Never commit a populated copy of this file.
PORT=3000
FRONTEND_ORIGINS=http://localhost:4200
JSON_BODY_LIMIT=256kb
SUPABASE_URL=https://<project-ref>.supabase.co
DATABASE_URL=postgresql://<non-service-role-user>:<password>@<db-host>:5432/postgres?schema=public
VAPID_SUBJECT=mailto:notifications@example.invalid
VAPID_PUBLIC_KEY=<base64url-public-key>
VAPID_PRIVATE_KEY=<base64url-private-key>

# Browser-only values belong in window.__T_MINUS_CONFIG__, not this file:
# supabaseUrl=https://<project-ref>.supabase.co
# supabaseAnonKey=<publishable-or-anon-key>
# apiUrl=http://localhost:3000
